#include <stdio.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "button.h"
#include "buzzer.h"


/*
 * [OURS]
 * A second FreeRTOS task.
 */
void background_task(void *arg)
{
    while (1)
    {
        printf("Background task is running...\n");

        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}


void app_main(void)
{
    button_init();
    buzzer_init();

    /*
     * [FreeRTOS]
     * Create our background task.
     */
    xTaskCreate(
        background_task,
        "background_task",
        2048,
        NULL,
        1,
        NULL
    );

    while (1)
    {
        /*
         * app_main task sleeps here
         * until button ISR wakes it.
         */
        ulTaskNotifyTake(
            pdTRUE,
            portMAX_DELAY
        );

        if (button_is_pressed())
        {
            printf("Valid button press!\n");

            buzzer_on();

            vTaskDelay(pdMS_TO_TICKS(200));

            buzzer_off();

            button_wait_for_release();
        }

        /*
         * Clear possible bounce notifications.
         */
        ulTaskNotifyTake(
            pdTRUE,
            0
        );
    }
}
